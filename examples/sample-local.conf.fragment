# OpenBMC build fragment — generated by Part 2 GUI (spec v1)
# Pinned mappings are in part2-mapping.md; unpinned items stay commented, never invented.
MACHINE = "evb-ast2600"
IMAGE_FEATURES:append = " obmc-bmcweb obmc-net-ipmi obmc-host-ipmi ssh-server-dropbear obmc-webui "
# NOTE: the services above are already in the default obmc-phosphor-image IMAGE_FEATURES; this append makes the selection explicit for a custom image recipe.
# RUNTIME (not a build setting): hostname = openbmc — set after first boot via phosphor-networkd (Redfish / D-Bus xyz.openbmc_project.Network). No local.conf hostname variable was found in either tree.
# RUNTIME (not a build setting): network mode = dhcp — apply after first boot via phosphor-networkd; no local.conf DHCP/static-IP variable was found in either tree. For a reproducible fleet setting, ship a systemd .network file in a custom layer (future work, not generated here).
# ARTIFACT (downstream use only): image_artifact_kind = static.mtd — upstream static.inc produces mtd-static / mtd-static-tar / mtd-static-alltar; pick the matching file from tmp/deploy/images/<machine>/ after the build.
# NOT DONE in Part 2: real bitbake build, QEMU boot run, service-removal verification, layer-drift maintenance, hostname/network runtime provisioning automation.
